rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Helpers
    function isSignedIn() { return request.auth != null; }
    function docIdValid(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Validation for Guestbook
    function isValidGuestEntry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
             data.role is string && data.role.size() > 0 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             data.timestamp is string &&
             data.createdAt == request.time;
    }

    // Validation for Users
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.acceptedCopyrightTerms is bool;
    }

    // Validation for Blog Posts
    function isValidBlogPost(data) {
      return data.authorId == request.auth.uid &&
             data.title is string && data.title.size() > 0 &&
             data.htmlContent is string && data.htmlContent.size() > 0 &&
             data.createdAt == request.time;
    }
    
    // Global Platform Statistics: Publicly readable for HUDs and landing metrics
    match /statistics/{docId} {
      allow get, list: if true;
    }

    // Intel Briefings & Blog Articles
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create: if isSignedIn() && 
                      isValidBlogPost(incoming()) && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.acceptedCopyrightTerms == true &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canGenerateBlogs == true;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Guestbook: Publicly readable, anyone signed in can post
    match /guestbook/{entryId} {
      allow list: if true;
      allow get: if true;
      allow create: if isSignedIn() && isValidGuestEntry(incoming());
      allow update, delete: if false; // Immutable ledger
    }

    // Marketplace Protocols: Publicly readable and listable for the marketplace catalog
    // and featured drops.
    match /protocols/{protocolId} {
      allow get, list: if true;
      // Allow incrementing viewCount publicly to support platform telemetry
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
      allow create, delete: if false; // Reserved for administrative nodes
    }

    // Audits: Users can create audits and read their own results
    match /audits/{auditId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
    }

    // User Profile & Secure Enclave Data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && 
                    (incoming().diff(resource.data).affectedKeys().hasOnly(['acceptedCopyrightTerms', 'displayName']) || 
                     isAdmin());

      match /{allPaths=**} {
        allow read, write, delete, list: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}