{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with permission tracking and terms acceptance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "acceptedCopyrightTerms": { "type": "boolean" },
        "canGenerateBlogs": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "author", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "acceptedCopyrightTerms"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "A blog post or intel briefing",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "htmlContent": { "type": "string" },
        "desc": { "type": "string" },
        "readTime": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "title", "htmlContent", "createdAt"]
    },
    "GuestbookEntry": {
      "title": "GuestbookEntry",
      "description": "A public message left in the secure guest ledger",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the visitor" },
        "role": { "type": "string", "description": "The badge role assigned" },
        "text": { "type": "string", "description": "The message content" },
        "timestamp": { "type": "string", "description": "ISO string or UTC time representation" },
        "createdAt": { "type": "string", "description": "FireStore server timestamp" }
      },
      "required": ["name", "role", "text", "timestamp", "createdAt"]
    },
    "Statistic": {
      "title": "Statistic",
      "description": "Global platform platform metrics",
      "type": "object",
      "properties": {
        "totalVolume": { "type": "number" },
        "activeAudits": { "type": "number" }
      }
    },
    "Protocol": {
      "title": "Protocol",
      "description": "A marketplace protocol listing",
      "type": "object",
      "properties": {
        "viewCount": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Intel briefings and blog articles"
    },
    "/guestbook/{entryId}": {
      "schema": "GuestbookEntry",
      "description": "The public ledger of messages"
    },
    "/statistics/{docId}": {
      "schema": "Statistic",
      "description": "Global statistics"
    },
    "/protocols/{protocolId}": {
      "schema": "Protocol",
      "description": "Protocol view counts and metadata"
    }
  }
}
